{
  "name": "lumif-focus-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:all": "npm run build:chrome && npm run build:firefox",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.33",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.1",
    "wxt": "^0.21.5"
  }
}
